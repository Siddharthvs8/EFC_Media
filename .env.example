# EFC Media — environment variables
#
# On Vercel these live in Project → Settings → Environment Variables.
# Locally, `vercel env pull .env.local` downloads them; never commit real values.

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────────────
# Created automatically when the Neon integration is connected to the Vercel project.
# DATABASE_URL is the pooled connection used by the app. DATABASE_URL_UNPOOLED is the
# direct connection used for migrations (`npm run migrate`).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ── Media storage (Vercel Blob) ───────────────────────────────────────────────────────
# Created automatically when a Blob store is connected to the Vercel project.
# Required on Vercel (uploads cannot use Vercel's temporary filesystem). Leave empty
# locally to store uploads in ./media instead.
BLOB_READ_WRITE_TOKEN=
# Optional folder inside the Blob store, e.g. "dev" to keep development uploads apart.
BLOB_PREFIX=

# ── Secrets (generate each with: openssl rand -hex 32) ────────────────────────────────
# Signs admin sessions and form tokens. Changing it signs everyone out.
PAYLOAD_SECRET=
# Protects the draft preview route used by the admin's Preview / Live Preview.
PREVIEW_SECRET=
# Vercel Cron sends this as a Bearer token to /api/payload-jobs/run (scheduled publishing).
CRON_SECRET=
# Optional separate secret for contact-form tokens (defaults to PAYLOAD_SECRET).
FORM_SECRET=

# ── Site URL ──────────────────────────────────────────────────────────────────────────
# Optional. Set once a custom domain is connected, e.g. https://www.efcmedia.com
# (used for canonical URLs, the sitemap and social sharing). Defaults to the Vercel URL.
NEXT_PUBLIC_SITE_URL=

# ── Email notifications for form submissions ──────────────────────────────────────────
# Where enquiry notifications go when a form's own "to" address is empty.
CONTACT_TO_EMAIL=
# Sender shown on notification emails (must be on a domain your email provider has verified).
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EFC Media website
# Option A — Resend (https://resend.com or the Vercel Marketplace):
RESEND_API_KEY=
# Option B — any SMTP provider (Google Workspace, Zoho, …). Used when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Seeding the first admin account (only read by `npm run seed`) ─────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Development only ──────────────────────────────────────────────────────────────────
# Lets Payload change the database schema on the fly instead of using migrations.
# Only ever use this with a throwaway local database.
PAYLOAD_DB_PUSH=
