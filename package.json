{
  "name": "efc-media",
  "version": "1.0.0",
  "description": "EFC Media \u2014 Your Growth Partner. Marketing website and CMS (Next.js + Payload).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "ci": "npm run migrate && npm run build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation DB_USE_UNPOOLED=true payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation DB_USE_UNPOOLED=true payload migrate:status",
    "migrate:prod": "cross-env NODE_ENV=production npm run migrate",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "seed:prod": "cross-env NODE_ENV=production npm run seed",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-form-builder": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@vercel/functions": "^3.11.2",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.1",
    "payload": "3.93.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/config": "^0.14.1",
    "dotenv": "16.4.7",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "24.x"
  }
}
